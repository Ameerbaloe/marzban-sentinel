# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
OWNER_TELEGRAM_ID=123456789

# Marzban
# Base URL of your Marzban installation/API
